# Copy to .env (git-ignored) and fill in. Tokens cache in ~/.garminconnect/ after login.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Only if several athletes share this computer: one token folder each.
# Empty = ~/.garminconnect
GARMIN_TOKEN_STORE=
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=
# Only for `export`: the Google Sheet that mirrors plan.md.
# The ID is the part of the URL between /d/ and /edit. Keep the service account's JSON
# key OUTSIDE the repository, e.g. ~/.config/smart-coach/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=